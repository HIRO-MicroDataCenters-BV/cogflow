# Framework versions baked into the runtime base images
# (hiroregistry/cogflow-runtime:torch-<TORCH_VERSION> / :tensor-<TF_VERSION>).
# Read by .github/workflows/runtime-images.yml (which builds the bases) and
# by .github/workflows/release.yml (which builds the per-release variants
# FROM them). Bump here, merge, let runtime-images.yml publish the new base,
# then the next cogflow release picks it up.
TORCH_VERSION=2.14.1
TF_VERSION=2.17.1
